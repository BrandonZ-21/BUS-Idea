{
  "name": "tally",
  "version": "1.0.0",
  "private": true,
  "description": "Tally: sales insights for small restaurants/cafes. Static site in public/, Cloudflare Pages Functions in functions/.",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "test": "node --test tests/square-server.test.mjs tests/accounts-unit.test.mjs",
    "test:flow": "node --test --test-concurrency=1 tests/square-flow.test.mjs",
    "test:accounts": "node --test --test-concurrency=1 tests/accounts-flow.test.mjs",
    "accounts:list:local": "node scripts/set-role.mjs --local --list",
    "db:migrate:local": "wrangler d1 migrations apply counter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply counter-db --remote"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrandonZ-21/BUS-Idea.git"
  },
  "devDependencies": {
    "wrangler": "^4.146.0"
  }
}
