// Cloudflare Pages config (https://developers.cloudflare.com/pages/functions/wrangler-configuration/).
// Once deployed, this file is the source of truth: the matching settings in the
// Cloudflare dashboard become read-only.
// No secrets in here -- they go in .dev.vars (local) or `wrangler pages secret put` (deployed).
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bus-idea", // must match the Pages project name (bus-idea.pages.dev)
	"pages_build_output_dir": "./public",
	"compatibility_date": "2026-09-30",
	// Non-secret settings. Top level = local `wrangler pages dev` and preview
	// deployments: always the Square Sandbox.
	"vars": {
		"SQUARE_ENVIRONMENT": "sandbox"
	},
	"d1_databases": [
		{
			"binding": "DB", // available in Functions as context.env.DB
			"database_name": "counter-db",
			"database_id": "455686fe-49c4-4c79-a0eb-3596921a2356",
			"migrations_dir": "migrations"
		}
	],
	// The live site (bus-idea.pages.dev) talks to real Square. Pages rule: once
	// any binding is overridden here, every binding must be repeated here too.
	"env": {
		"production": {
			"vars": {
				"SQUARE_ENVIRONMENT": "production",
				// Anonymous usage steps for the founder dashboard (approved 2026-10-02).
				// Remove this line to stop counting; nothing else changes.
				"USAGE_EVENTS": "on"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "counter-db",
					"database_id": "455686fe-49c4-4c79-a0eb-3596921a2356",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}